{
  "name": "MyList",
  "short_name": "MyList",
  "description": "La tua to-do list veloce, con dettatura e smistamento intelligente.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "it",
  "background_color": "#E3E3DF",
  "theme_color": "#F5B800",
  "categories": ["productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Detta una voce",
      "short_name": "Detta",
      "url": "./?voice=1",
      "icons": [{ "src": "icons/shortcut-mic.png", "sizes": "96x96", "type": "image/png" }]
    },
    {
      "name": "Scrivi una voce",
      "short_name": "Scrivi",
      "url": "./?new=1",
      "icons": [{ "src": "icons/shortcut-add.png", "sizes": "96x96", "type": "image/png" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
